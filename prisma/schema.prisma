// 설계도 시작
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL") // 여기 이름을 맞췄습니다!
}

// 방명록 테이블 구조
model messages {
  id         Int      @id @default(autoincrement())
  name       String
  content    String
  created_at DateTime @default(now())
}

// 티켓팅 연습 기록 테이블
model ticketing_practice {
  id        Int    @id @default(autoincrement())
  name      String
  stopwatch Int
}

// ─────────────────────────────────────────────────────
// 개인 서버 관리용 중앙 API (Home Server Agent 연동 기반)
// ─────────────────────────────────────────────────────

enum ProjectStatus {
  running
  stopped
  starting
  stopping
  restarting
  error
  unknown
}

enum CommandAction {
  start
  stop
  restart
}

enum CommandStatus {
  pending
  processing
  success
  failed
  cancelled
}

enum CommandSource {
  web
  discord
  system
}

enum AgentStatus {
  online
  offline
  unknown
}

enum LogLevel {
  info
  warn
  error
}

// 서버컴에서 실행되는 Agent (현재는 등록/조회용, 실제 연결은 추후 구현)
model Agent {
  id         String      @id @default(cuid())
  name       String      @unique
  status     AgentStatus @default(unknown)
  lastSeenAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  projects Project[]

  @@map("agents")
}

// 관리 대상 프로젝트 (웹사이트/디스코드 봇/워커 등)
model Project {
  id          String        @id
  name        String
  description String?
  status      ProjectStatus @default(unknown)
  port        Int?
  // 'web' | 'discord-bot' | 'worker' | 'api' | 'other' 등 (server/types/enums.js 참고)
  type        String
  // 추후 PM2/Docker 제어 시 사용할 "내부 프로세스 이름".
  // 클라이언트가 임의로 넘길 수 없고 항상 DB에 등록된 값만 사용한다.
  processName String?

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  commands Command[]

  @@index([agentId])
  @@map("projects")
}

// Web/Discord에서 생성되고, 나중에 Home Server Agent가 처리하는 제어 명령
model Command {
  id     String        @id @default(cuid())
  action CommandAction
  status CommandStatus @default(pending)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  // 명령을 요청한 주체(관리자 아이디 / discord 사용자 등). 시스템 발행 명령은 null일 수 있다.
  requestedBy String?
  source      CommandSource

  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  logs CommandLog[]

  @@index([projectId])
  @@index([status])
  @@map("commands")
}

// Command 상태 변화 / 처리 결과 로그
model CommandLog {
  id        String   @id @default(cuid())
  commandId String
  command   Command  @relation(fields: [commandId], references: [id])
  level     LogLevel @default(info)
  message   String
  createdAt DateTime @default(now())

  @@index([commandId])
  @@map("command_logs")
}
