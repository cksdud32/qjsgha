// 설계도 시작
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 애플리케이션(lib/db.js)과 같은 환경변수를 쓴다.
  // DB 를 옮길 때 DATABASE_URL 하나만 바꾸면 앱과 Prisma CLI 가 함께 따라간다.
  url      = env("DATABASE_URL")
}

// ⚠️ 주의: 아래 모델은 실제 DB 의 일부만 반영하고 있다.
// 운영 DB 에는 concert, karaoke_number, questions, difficulty, quiz_ranking,
// notice, goods, waiting_group, discord_channels, site_config, AdminUsers,
// SuggestedQuestions, pending_karaoke 등의 테이블이 더 있다.
// 서버컴 이전 전에 `npm run db:pull` 로 스키마를 실제 DB 와 동기화할 것.
// (자세한 절차는 docs/DB-MIGRATION.md 참고)

// 방명록 테이블 구조
model messages {
  id         Int      @id @default(autoincrement())
  name       String
  content    String
  created_at DateTime @default(now())
}

// 티켓팅 연습 기록 테이블
model ticketing_practice {
  id        Int    @id @default(autoincrement())
  name      String
  stopwatch Int
}

// ─────────────────────────────────────────────────────
// 개인 서버 관리용 중앙 API (Home Server Agent 연동 기반)
// ─────────────────────────────────────────────────────

enum ProjectStatus {
  running
  stopped
  starting
  stopping
  restarting
  error
  unknown
}

enum CommandAction {
  start
  stop
  restart
}

enum CommandStatus {
  pending
  processing
  success
  failed
  cancelled
}

enum CommandSource {
  web
  discord
  system
}

enum AgentStatus {
  online
  offline
  unknown
}

enum LogLevel {
  info
  warn
  error
}

// 서버컴에서 실행되는 Agent (현재는 등록/조회용, 실제 연결은 추후 구현)
model Agent {
  id         String      @id @default(cuid())
  name       String      @unique
  status     AgentStatus @default(unknown)
  lastSeenAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  projects Project[]

  @@map("agents")
}

// 관리 대상 프로젝트 (웹사이트/디스코드 봇/워커 등)
model Project {
  id          String        @id
  name        String
  description String?
  status      ProjectStatus @default(unknown)
  port        Int?
  // 'web' | 'discord-bot' | 'worker' | 'api' | 'other' 등 (server/types/enums.js 참고)
  type        String
  // 추후 PM2/Docker 제어 시 사용할 "내부 프로세스 이름".
  // 클라이언트가 임의로 넘길 수 없고 항상 DB에 등록된 값만 사용한다.
  processName String?

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  commands Command[]

  @@index([agentId])
  @@map("projects")
}

// Web/Discord에서 생성되고, 나중에 Home Server Agent가 처리하는 제어 명령
model Command {
  id     String        @id @default(cuid())
  action CommandAction
  status CommandStatus @default(pending)

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  // 명령을 요청한 주체(관리자 아이디 / discord 사용자 등). 시스템 발행 명령은 null일 수 있다.
  requestedBy String?
  source      CommandSource

  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?

  logs CommandLog[]

  @@index([projectId])
  @@index([status])
  @@map("commands")
}

// Command 상태 변화 / 처리 결과 로그
model CommandLog {
  id        String   @id @default(cuid())
  commandId String
  command   Command  @relation(fields: [commandId], references: [id])
  level     LogLevel @default(info)
  message   String
  createdAt DateTime @default(now())

  @@index([commandId])
  @@map("command_logs")
}
