# 테스트 전용 환경변수 템플릿.
#
# 실제 값은 .env.test 에 넣는다(.gitignore 됨). 운영용 .env 와 절대 섞지 않는다.
# 보통은 이 파일이 필요 없다 — `npm run test:full` 이 격리된 임시 PostgreSQL 을
# 스스로 띄우고 TEST_DATABASE_URL 을 내부에서 만들어 쓴다.
#
# scripts/test/apply-test-sql.mjs 를 수동으로 돌릴 때만 아래를 채운다.
# host 는 반드시 localhost / 127.0.0.1 / ::1 이어야 한다(래퍼가 강제).

TEST_DATABASE_URL=postgres://postgres:password@127.0.0.1:54329/qjsgha_test

# Agent 라우트 테스트용 더미 토큰 (운영 토큰 아님)
AGENT_API_TOKEN=test-agent-token-local
