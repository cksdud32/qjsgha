# Database (Prisma / pg 공용)
PRISMA_DATABASE_URL=
POSTGRES_URL=

# Discord Bot
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
ADMIN_CHANNEL_ID=

# Vercel Cron
CRON_SECRET=

# ── 개인 서버 관리용 중앙 API ──────────────────────────
# Home Server Agent가 /api/agent/* 엔드포인트를 호출할 때 사용하는 전용 토큰.
# 관리자 로그인(AdminUsers)과는 별개의 인증이며, Authorization: Bearer <값> 형태로 사용한다.
AGENT_API_TOKEN=

# mock | (미설정)
# mock일 때는 실제 Agent가 없다는 안내 로그를 Command 생성 시 CommandLog에 남긴다.
# scripts/mock-agent.js 로 로컬에서 Agent 동작을 흉내낼 때도 이 값을 사용한다.
SERVER_CONTROL_MODE=
