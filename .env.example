# 실제 값은 절대 여기에 쓰지 않는다.
# 로컬은 .env / .env.local, 배포는 Vercel Environment Variables 에 넣는다.

# ── DB (필수) ────────────────────────────────────────────────
# 애플리케이션이 사용하는 단 하나의 DB 연결 문자열.
# 표준 PostgreSQL URL 이면 공급자가 무엇이든 그대로 동작한다.
#   현재:   postgres://<user>:<password>@<host>:5432/<db>?sslmode=require
#   서버컴: postgres://<user>:<password>@<server-ip>:5432/<db>
DATABASE_URL=

# ── DB 옵션 (선택) ───────────────────────────────────────────
# SSL 모드. 미설정 시 no-verify (암호화 O, 인증서 검증 X) — 현재 운영과 동일.
#   no-verify | disable | require | verify-full
# 사설망 서버컴처럼 TLS 를 쓰지 않는 PostgreSQL 로 옮길 때 disable 로 바꾼다.
DATABASE_SSL=

# 자체 서명 인증서를 검증하려는 경우에만 사용 (PEM 본문)
DATABASE_SSL_CA=

# 커넥션 풀 튜닝. 미설정 시 pg 기본값을 사용한다.
# serverless 는 인스턴스마다 풀이 생기므로 값을 작게 잡는 편이 안전하다.
DB_POOL_MAX=
DB_IDLE_TIMEOUT_MS=
DB_CONNECT_TIMEOUT_MS=

# ── 레거시 별칭 (하위 호환) ──────────────────────────────────
# DATABASE_URL 이 없을 때만 아래 순서로 사용된다.
# DATABASE_URL 로 정리한 뒤에는 지워도 된다.
POSTGRES_URL=
PRISMA_DATABASE_URL=

# ── Discord ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# 관리자 권한 체크용 Discord 사용자 ID (discord-interactions.js)
ADMIN_USER_ID=
# 알림을 전송할 Discord 채널 ID (discord-notify.js) — ADMIN_USER_ID와 별개 용도
ADMIN_CHANNEL_ID=

# ── 개인 서버 관리용 중앙 API ──────────────────────────
# Home Server Agent가 /api/agent/* 엔드포인트를 호출할 때 사용하는 전용 토큰.
# 관리자 로그인(AdminUsers)과는 별개의 인증이며, Authorization: Bearer <값> 형태로 사용한다.
AGENT_API_TOKEN=

# mock | (미설정)
# mock일 때는 실제 Agent가 없다는 안내 로그를 Command 생성 시 CommandLog에 남긴다.
# scripts/mock-agent.js 로 로컬에서 Agent 동작을 흉내낼 때도 이 값을 사용한다.
SERVER_CONTROL_MODE=
